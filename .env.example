# Öffentliche Adresse der App (für Links in E-Mails und die Microsoft/Google-Anmeldung)
APP_URL=http://localhost:3000
DATABASE_URL=mysql://taktwerk:taktwerk@localhost:3306/taktwerk
SESSION_DAYS=14

# E-Mail über SMTP. Ohne SMTP_HOST werden E-Mails nur ins Server-Log geschrieben.
SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (implizites TLS), sonst STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Taktwerk <no-reply@example.ch>

# Anmeldung mit Microsoft (Entra ID). Redirect-URI: <APP_URL>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# organizations = alle Firmenkonten, oder die Tenant-ID für nur eine Firma
MICROSOFT_TENANT=organizations

# Anmeldung mit Google. Redirect-URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jira Cloud: App aus developer.atlassian.com (OAuth 2.0). Callback-URL: <APP_URL>/api/jira/callback
# Anleitung: docs/BETRIEB.md, Abschnitt «Jira Cloud verbinden»
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# bexio: App aus developer.bexio.com (OAuth). Redirect-URL: <APP_URL>/api/bexio/callback
# Anleitung: docs/BETRIEB.md, Abschnitt «bexio und Lohnexport»
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=

# Ablage für hochgeladene Belege
DATA_DIR=./data
