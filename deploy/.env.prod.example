# TrackInsight – Produktions-Konfiguration
# Kopieren nach deploy/.env.prod und alle Werte ausfüllen:  cp deploy/.env.prod.example deploy/.env.prod
# Diese Datei wird von allen Containern gelesen (app, db, caddy, backup).
# Sichere Passwörter erzeugen:  openssl rand -base64 32

# ---- Domain und öffentliche Adresse --------------------------------------
# Domain, unter der die App erreichbar ist (DNS A-Record muss auf die VM zeigen).
APP_DOMAIN=zeit.firma.ch
# Öffentliche URL der App: für Links in E-Mails, Microsoft/Google-Anmeldung und den CSRF-Schutz.
# Muss https:// und genau die Domain von oben enthalten.
APP_URL=https://zeit.firma.ch

# ---- Datenbank -----------------------------------------------------------
# Root-Passwort der MariaDB (nur für Wartung, wird von der App nicht benutzt).
MARIADB_ROOT_PASSWORD=BITTE-AENDERN-root
# Passwort des App-Benutzers «taktwerk». Wird vom db-Container beim ersten Start gesetzt
# und vom backup-Container zum Sichern verwendet.
MARIADB_PASSWORD=BITTE-AENDERN-db
# Verbindung der App zur Datenbank. Das Passwort hier muss mit MARIADB_PASSWORD übereinstimmen!
# Sonderzeichen im Passwort müssen URL-kodiert sein (z. B. @ -> %40, / -> %2F, # -> %23).
DATABASE_URL=mysql://taktwerk:BITTE-AENDERN-db@db:3306/taktwerk

# ---- Sitzungen -----------------------------------------------------------
# Wie viele Tage eine Anmeldung gültig bleibt.
SESSION_DAYS=14
# Hinweis: Sitzungen werden in der Datenbank gespeichert (zufällige Tokens), ein SESSION_SECRET
# ist nicht nötig und wird vom Server nicht gelesen.

# ---- E-Mail (SMTP) -------------------------------------------------------
# Ohne SMTP_HOST werden E-Mails nur ins Server-Log geschrieben (Einladungen kommen dann nicht an!).
# Empfehlung: Schweizer Anbieter, z. B. Infomaniak Mail (mail.infomaniak.com, Port 587, STARTTLS).
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
# true nur für Port 465 (implizites TLS), sonst false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=no-reply@firma.ch
SMTP_PASSWORD=BITTE-AENDERN-smtp
SMTP_FROM=TrackInsight <no-reply@firma.ch>

# ---- Anmeldung mit Microsoft (optional) ----------------------------------
# Redirect-URI in Entra ID: <APP_URL>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# organizations = alle Firmenkonten, oder die Tenant-ID für nur eine Firma
MICROSOFT_TENANT=organizations

# ---- Anmeldung mit Google (optional) -------------------------------------
# Redirect-URI in der Google Cloud Console: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Registrierung -------------------------------------------------------
# true: Firmen können sich selbst unter /registrieren anmelden (SaaS-Betrieb).
# false: neue Organisationen nur durch Plattform-Admins oder per CLI (init).
REGISTRATION_OPEN=false

# ---- SaaS-Betrieb mit Abo (optional) ---------------------------------------
# true: Pakete Start/Team/Business mit Preis pro Person, 30 Tage Testphase, danach nur lesend
# ohne Paket. Jede Firma läuft unter <kürzel>.<SAAS_BASE_DOMAIN>. Selbst gehostete
# Installationen lassen SAAS=false: dann gibt es keine Grenzen.
SAAS=false
# z. B. trackinsight.ch. DNS: trackinsight.ch und *.trackinsight.ch auf diesen Server.
# Läuft die App auf app.trackinsight.ch (APP_DOMAIN/APP_URL oben), zeigt trackinsight.ch die Website.
SAAS_BASE_DOMAIN=
# Wohin Meldungen an den Betreiber gehen (neue Firmen, Rechnungen stellen, Kündigungen).
OPERATOR_EMAIL=
# Kartenzahlung über Stripe (leer lassen = Bezahlung auf Rechnung). Schlüssel nie in Chats
# oder E-Mails weitergeben, nur hier eintragen. Webhook in Stripe: <APP_URL>/api/billing/webhook
# mit den Ereignissen checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preis-IDs aus Stripe (Preis pro Person), je Paket und Zahlungsweise:
# start_month=price_…,start_year=price_…,team_month=…,team_year=…,business_month=…,business_year=…
STRIPE_PRICES=

# ---- Jira Cloud (optional) ------------------------------------------------
# App in developer.atlassian.com, Callback-URL <APP_URL>/api/jira/callback (Anleitung in docs/BETRIEB.md).
# Den Schlüssel nur hier eintragen, nie in Chats oder E-Mails.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ---- bexio (optional) -----------------------------------------------------
# App in developer.bexio.com, Redirect-URL <APP_URL>/api/bexio/callback (Anleitung in docs/BETRIEB.md).
# Den Schlüssel nur hier eintragen, nie in Chats oder E-Mails.
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=

# ---- Dateiablage ---------------------------------------------------------
# Belege und Logo. Im Container fest auf /app/data (Docker-Volume «data»); nicht ändern.
DATA_DIR=/app/data

# ---- Backup (optional: Kopie in einen S3-Bucket in der Schweiz) ----------
# Nächtliche Dumps liegen immer im Docker-Volume «backups» (siehe docs/BETRIEB.md).
# Zusätzlich kann jedes Backup in einen S3-kompatiblen Bucket kopiert werden
# (Exoscale SOS, Region ch-gva-2 / ch-dk-2, oder Infomaniak Swiss Backup).
# Leer lassen = aus. Zum Einschalten alle vier Werte setzen.
BACKUP_S3_BUCKET=
# Exoscale Genf: https://sos-ch-gva-2.exo.io   Exoscale Zürich: https://sos-ch-dk-2.exo.io
# Infomaniak Swiss Backup: Endpoint aus dem Manager (s3.swiss-backup0x.infomaniak.com)
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Region, falls der Anbieter sie verlangt (Exoscale: ch-gva-2 bzw. ch-dk-2)
BACKUP_S3_REGION=
