{
  "name": "taktwerk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/domain",
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "test": "npm test -w @taktwerk/domain && npm test -w server",
    "typecheck": "npm run typecheck -ws",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
